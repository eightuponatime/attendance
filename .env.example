POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change_this_strong_password
APP_HOST_PORT=3011

ENV=production
BUSINESS_TIMEZONE=Asia/Almaty
VITE_BUSINESS_TIMEZONE=Asia/Almaty
CORPORATE_DOMAIN=goldencompass.kz
SESSION_TTL=2160h

# Set this to the public origin nginx exposes, for example:
# FRONTEND_URL=https://your-server.example.com:33237
FRONTEND_URL=/

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
GOOGLE_ADMIN_REDIRECT_URL=

WORKDAY_START=08:00
WORKDAY_END=17:00

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_TIME=08:30

HEARTBEAT_INTERVAL=1m
OUTAGE_THRESHOLD=5m
OUTAGE_IMPACT_START=06:00
OUTAGE_IMPACT_END=19:00

